{
    "name": "itinerisltd/gf-sagepay",
    "description": "Gravity Forms Add-on for SagePay",
    "license": "MIT",
    "type": "wordpress-plugin",
    "keywords": [
        "gravityforms",
        "gravity-forms",
        "payment",
        "sagepay",
        "wordpress",
        "wp"
    ],
    "authors": [
        {
            "name": "Itineris Limited",
            "email": "dev@itineris.co.uk",
            "homepage": "https://itineris.co.uk/",
            "role": "Company"
        },
        {
            "name": "Tang Rufus",
            "email": "tangrufus@gmail.com",
            "homepage": "https://typist.tech/",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/ItinerisLtd/gf-sagepay",
    "support": {
        "email": "dev@itineris.co.uk",
        "issues": "https://github.com/ItinerisLtd/gf-sagepay/issues",
        "source": "https://github.com/ItinerisLtd/gf-sagepay"
    },
    "require": {
        "php": "^8.4.1",
        "ext-bcmath": "*",
        "ext-curl": "*",
        "league/omnipay": "^3.2",
        "omnipay/common": "^3.5.1",
        "omnipay/sagepay": "^4.1"
    },
    "require-dev": {
        "alleyinteractive/pest-plugin-wordpress": "^1.1",
        "itinerisltd/itineris-wp-coding-standards": "^2.0",
        "pestphp/pest": "^5.3",
        "php-http/mock-client": "^1.6",
        "roave/security-advisories": "dev-master"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Itineris\\SagePay\\": "src/"
        }
    },
    "archive": {
        "exclude": [
            "*",
            "!*LICENSE*",
            "!*.php",
            "!/README.txt",
            "!src",
            "test",
            "tests"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": false
        },
        "platform": {
            "php": "8.4.1"
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.x-dev"
        }
    },
    "scripts": {
        "release:build": [
            "rm -fr vendor",
            "composer install --no-dev --prefer-dist --optimize-autoloader --no-suggest",
            "rm -fr release wordpress",
            "composer archive --format=zip --dir=release --file=gf-sagepay"
        ],
        "style:check": "phpcs",
        "style:fix": "phpcbf",
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "pest"
        ]
    }
}
